# Free-first provider configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=4

# Local Piper TTS (no cloud API key)
TTS_PROVIDER=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL=

# Optional paid/fallback providers
OPENAI_API_KEY=
OPENAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube OAuth (enable only after local render passes QA)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Rendering
OUTPUT_DIR=./output
FFMPEG_BIN=ffmpeg

# Safety defaults
DRY_RUN=true
PUBLISH_ENABLED=false
