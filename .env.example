# Copy to .env for local runs. Never commit real credentials.
APP_ENV=development
OUTPUT_DIR=./output
CONFIG_FILE=./config/channel.yaml

# LLM / script generation
OPENAI_API_KEY=
OPENAI_MODEL=

# NASA Image & Video Library is keyless for this adapter.
# Do not place NASA credentials here unless a future provider explicitly requires them.

# TTS provider (implementation can be swapped without changing the pipeline)
TTS_PROVIDER=
TTS_API_KEY=

# YouTube OAuth credentials (keep in GitHub Actions secrets for CI publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
